From 392f9b6ea98cc1633dffe61b2e251c774bcd4319 Mon Sep 17 00:00:00 2001
From: Dre Gilley <dre@dregilley.com>
Date: Sat, 3 Oct 2026 22:45:24 -0400
Subject: [PATCH 01/12] WIP: port Genesis G70 2024 platform (GENESIS_G70_2024)

Adapted from commaai/opendbc cfb743f4 / PR #1134 (pinned by sunnypilot
branch g70-2024-port-new) onto dev 0b2c431d:
- fingerprints: camera + radar FW for G70 2024
- values: GENESIS_G70_2024 CAN platform, CHECKSUM_CRC8 | CAMERA_SCC
- hyundaican: LKAS11 LDWS fields list (manual merge, list grew upstream)
- torque override (manual merge into port extensions section)
- sunnypilot car_list.json entry (hand-written; generator check pending)
- routes: non_tested_cars port extension (reference routes not in CI)

No safety (panda) changes. UNTESTED: no Linux toolchain yet.

Assisted-by: Claude
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 opendbc_repo/opendbc/car/hyundai/fingerprints.py   |  8 ++++++++
 opendbc_repo/opendbc/car/hyundai/hyundaican.py     |  3 ++-
 opendbc_repo/opendbc/car/hyundai/values.py         |  5 +++++
 opendbc_repo/opendbc/car/tests/routes.py           |  1 +
 opendbc_repo/opendbc/car/torque_data/override.toml |  1 +
 opendbc_repo/opendbc/sunnypilot/car/car_list.json  | 10 ++++++++++
 6 files changed, 27 insertions(+), 1 deletion(-)

diff --git a/opendbc_repo/opendbc/car/hyundai/fingerprints.py b/opendbc_repo/opendbc/car/hyundai/fingerprints.py
index acbac58065..30768390f2 100644
--- a/opendbc_repo/opendbc/car/hyundai/fingerprints.py
+++ b/opendbc_repo/opendbc/car/hyundai/fingerprints.py
@@ -1300,6 +1300,14 @@ FW_VERSIONS = {
       b'\xf1\x00T01G00BL  T01I00A1  DOS2T16X4XI00NS0\x99L\xeeq',
     ],
   },
+  CAR.GENESIS_G70_2024: {
+    (Ecu.fwdCamera, 0x7c4, None): [
+      b'\xf1\x00IK  MFC  AT USA LHD 1.00 1.02 99211-G9500 230712',
+    ],
+    (Ecu.fwdRadar, 0x7d0, None): [
+      b'\xf1\x00IKPE RDR -----      1.00 1.00 99110-G9600         ',
+    ],
+  },
 }
 
 FW_VERSIONS = merge_fw_versions(FW_VERSIONS, FW_VERSIONS_EXT)
diff --git a/opendbc_repo/opendbc/car/hyundai/hyundaican.py b/opendbc_repo/opendbc/car/hyundai/hyundaican.py
index 426e11bd9b..5bdca5dfc3 100644
--- a/opendbc_repo/opendbc/car/hyundai/hyundaican.py
+++ b/opendbc_repo/opendbc/car/hyundai/hyundaican.py
@@ -45,7 +45,8 @@ def create_lkas11(packer, frame, CP, apply_torque, steer_req,
                            CAR.HYUNDAI_SANTA_FE_PHEV_2022, CAR.KIA_STINGER_2022, CAR.KIA_K5_HEV_2020, CAR.KIA_CEED,
                            CAR.HYUNDAI_AZERA_6TH_GEN, CAR.HYUNDAI_AZERA_HEV_6TH_GEN, CAR.HYUNDAI_CUSTIN_1ST_GEN, CAR.HYUNDAI_KONA_2022,
                            CAR.KIA_CEED_PHEV_2022_NON_SCC, CAR.HYUNDAI_KONA_EV_NON_SCC, CAR.HYUNDAI_ELANTRA_2022_NON_SCC,
-                           CAR.GENESIS_G70_2021_NON_SCC, CAR.KIA_SELTOS_2023_NON_SCC, CAR.HYUNDAI_BAYON_1ST_GEN_NON_SCC):
+                           CAR.GENESIS_G70_2021_NON_SCC, CAR.KIA_SELTOS_2023_NON_SCC, CAR.HYUNDAI_BAYON_1ST_GEN_NON_SCC,
+                           CAR.GENESIS_G70_2024):
     values["CF_Lkas_LdwsActivemode"] = int(left_lane) + (int(right_lane) << 1)
     values["CF_Lkas_LdwsOpt_USM"] = 2
 
